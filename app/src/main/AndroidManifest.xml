<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission
        android:name="android.permission.INTERNET" />

    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Needed for direct file:// HTML access on Android 4.4. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-permission
        android:name="android.permission.CAMERA" />

    <uses-permission
        android:name="android.permission.RECORD_AUDIO" />

    <application
        android:theme="@style/BrowserTheme"
        android:label="Simple Browser"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:hardwareAccelerated="true">

        <activity
            android:name=".ProfileRouterActivity"
            android:exported="true"
            android:hardwareAccelerated="true">

            <!-- Normal app launcher. -->
            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

            <!-- Make Simple Browser eligible to open HTTP/HTTPS links
                 and therefore appear as a browser/default-browser choice. -->
            <intent-filter>

                <action
                    android:name="android.intent.action.VIEW" />

                <category
                    android:name="android.intent.category.DEFAULT" />

                <category
                    android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="http" />

                <data
                    android:scheme="https" />

            </intent-filter>

            <!-- Accept local HTML files passed from file managers. -->
            <intent-filter>

                <action
                    android:name="android.intent.action.VIEW" />

                <category
                    android:name="android.intent.category.DEFAULT" />

                <data
                    android:scheme="file"
                    android:mimeType="text/html" />

                <data
                    android:scheme="file"
                    android:mimeType="application/xhtml+xml" />

            </intent-filter>

            <!-- Accept content-provider HTML documents from modern
                 document/file picker apps. -->
            <intent-filter>

                <action
                    android:name="android.intent.action.VIEW" />

                <category
                    android:name="android.intent.category.DEFAULT" />

                <data
                    android:scheme="content"
                    android:mimeType="text/html" />

                <data
                    android:scheme="content"
                    android:mimeType="application/xhtml+xml" />

            </intent-filter>

        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:hardwareAccelerated="true" />

        <activity
            android:name=".ProfileSwitchActivity"
            android:process=":profileswitch"
            android:theme="@style/BrowserTheme"
            android:exported="false"
            android:noHistory="false" />

        <activity
            android:name=".ProfileProcess1Activity"
            android:process=":profile1"
            android:theme="@style/BrowserTheme"
            android:exported="false" />

        <activity
            android:name=".ProfileProcess2Activity"
            android:process=":profile2"
            android:theme="@style/BrowserTheme"
            android:exported="false" />

        <activity
            android:name=".ProfileProcess3Activity"
            android:process=":profile3"
            android:theme="@style/BrowserTheme"
            android:exported="false" />

        <activity
            android:name=".ProfileProcess4Activity"
            android:process=":profile4"
            android:theme="@style/BrowserTheme"
            android:exported="false" />

        <activity
            android:name=".ProfileProcess5Activity"
            android:process=":profile5"
            android:theme="@style/BrowserTheme"
            android:exported="false" />

        <activity
            android:name=".ProfileProcess6Activity"
            android:process=":profile6"
            android:theme="@style/BrowserTheme"
            android:exported="false" />

        <activity
            android:name=".ProfileProcess7Activity"
            android:process=":profile7"
            android:theme="@style/BrowserTheme"
            android:exported="false" />

        <activity
            android:name=".ProfileProcess8Activity"
            android:process=":profile8"
            android:theme="@style/BrowserTheme"
            android:exported="false" />

        <service
            android:name=".ProfileSwitchService"
            android:process=":profileswitch"
            android:exported="false" />

        <provider
            android:name=".UpdateApkProvider"
            android:authorities="com.example.simplebrowser.update"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>

</manifest>
